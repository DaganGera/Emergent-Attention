# Copy this file to .env and fill in real values.
# Any OpenAI-compatible chat-completions endpoint works here (NVIDIA NIM,
# Groq, OpenRouter, a local vLLM/Ollama server, ...) -- only these three
# variables change between providers.

# NVIDIA NIM (used during development):
REASONING_BASE_URL=https://integrate.api.nvidia.com/v1
REASONING_API_KEY=nvapi-...
REASONING_MODEL=meta/llama-3.1-8b-instruct

# Groq (swap in by uncommenting these and commenting out the NVIDIA lines above):
# REASONING_BASE_URL=https://api.groq.com/openai/v1
# REASONING_API_KEY=gsk_...
# REASONING_MODEL=llama-3.3-70b-versatile
