# Data and checkpoints (root-level only — do NOT match src/data or configs/data)
/data/
/checkpoints/
*.pt
*.pth

# Experiment tracking
wandb/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.env
.venv
env/
venv/

# Hydra outputs
outputs/
multirun/
.hydra/

# Results and figures (generated, not source)
results/*.csv
results/*.json
figures/*.png
figures/*.pdf
figures/*.gif
# Exception: the curated figures paper.md actually embeds. Regenerable from
# scripts/plot_*.py, but committed anyway so the paper renders on GitHub for
# a reader who just cloned the repo, instead of showing broken image links.
!figures/paper/
!figures/paper/*.png

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
